{
  "manifest_version": 3,
  "name": "BetterJiraWT",
  "version": "1.1.0",
  "description": "擴充 & 簡化 Jira 的功能，美化 Jira 版面",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.atlassian.net/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BetterJiraWT 選單",
    "default_icon": {
      "16": "icons/icon_default_16.png",
      "48": "icons/icon_default_48.png",
      "128": "icons/icon_default_128.png"
    }
  },
  "icons": {
    "16": "icons/icon_default_16.png",
    "48": "icons/icon_default_48.png",
    "128": "icons/icon_default_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "db.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
